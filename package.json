{
  "name": "rustfs-design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RustFS brand and design system site",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run tokens && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "lint:design": "npx @google/design.md lint DESIGN.md",
    "skill": "node scripts/build-tokens.mjs && python3 scripts/package-skill.py",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "html-to-image": "1.11.11",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "qrcode-generator": "1.4.4",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.27.0"
}
